<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0">
  <diagram id="gameflow" name="Game flow (screens)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="&lt;b&gt;Game flow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666666&quot;&gt;All screens and panels come from core. A game only supplies its gameplay, content, art and theme.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- Row 1: start-up and menus -->
        <mxCell id="boot" value="&lt;b&gt;Boot&lt;/b&gt;&lt;br&gt;loading-screen art" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pre" value="&lt;b&gt;Preloader&lt;/b&gt;&lt;br&gt;images · audio · fonts&lt;br&gt;api mode: wait for backend&lt;br&gt;then studio splash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="260" y="130" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="menu" value="&lt;b&gt;Main Menu&lt;/b&gt;&lt;br&gt;Play · [Settings]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="levels" value="&lt;b&gt;Level Selection&lt;/b&gt;&lt;br&gt;[Back] [Settings]&lt;br&gt;locked / unlocked cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="135" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Game -->
        <mxCell id="gamebox" value="Game (one level)" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;rounded=1;arcSize=4;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="gs" value="&lt;b&gt;Game scene&lt;/b&gt;&lt;br&gt;runs the game's gameplay&lt;br&gt;ctx.win() / ctx.lose()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="gamebox">
          <mxGeometry x="20" y="45" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;HUD&lt;/b&gt; (UIScene, on top)&lt;br&gt;[Pause] [Settings]&lt;br&gt;HUD text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="gamebox">
          <mxGeometry x="320" y="45" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="gsui" value="events" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="gamebox" source="gs" target="ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tut" value="&lt;b&gt;Tutorial&lt;/b&gt; · first play of level 1&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pauses the game&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="gamebox">
          <mxGeometry x="20" y="145" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hint" value="&lt;b&gt;Hint bubble&lt;/b&gt; · ctx.showHint()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;does not pause&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;" vertex="1" parent="gamebox">
          <mxGeometry x="300" y="145" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Overlays -->
        <mxCell id="overlays" value="Overlays &lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;(pause the game while open)&lt;/font&gt;" style="swimlane;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1200" y="300" width="260" height="290" as="geometry" />
        </mxCell>
        <mxCell id="pause" value="&lt;b&gt;Pause panel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Resume → back to the game&lt;br&gt;Restart → same level again&lt;br&gt;Quit → Main Menu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="overlays">
          <mxGeometry x="20" y="44" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="settings" value="&lt;b&gt;Settings panel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;music · sound volume&lt;br&gt;also opens from Main Menu&lt;br&gt;and Level Selection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="overlays">
          <mxGeometry x="20" y="136" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bgpause" value="&lt;b&gt;App / tab hidden&lt;/b&gt; → opens Pause&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(planned)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;dashed=1;" vertex="1" parent="overlays">
          <mxGeometry x="20" y="228" width="220" height="48" as="geometry" />
        </mxCell>

        <!-- Results -->
        <mxCell id="results" value="Result panel &lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;(over the Game scene)&lt;/font&gt;" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="620" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="won" value="&lt;b&gt;Game Completed&lt;/b&gt;&lt;br&gt;Replay · Home · Next&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(no Next on the last level)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="results">
          <mxGeometry x="20" y="42" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="lost" value="&lt;b&gt;Game Over&lt;/b&gt;&lt;br&gt;Retry · Home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="results">
          <mxGeometry x="300" y="42" width="240" height="72" as="geometry" />
        </mxCell>

        <!-- Notes column -->
        <mxCell id="save" value="&lt;b&gt;When a level ends&lt;/b&gt;, core:&lt;br&gt;1. saves progress on the device (stars, high score, unlocks next level)&lt;br&gt;2. &lt;font color=&quot;#4d7a3a&quot;&gt;api mode:&lt;/font&gt; posts the result to the backend&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9c7a12&quot;&gt;local mode:&lt;/font&gt; sends levelEnd over the bridge&lt;br&gt;3. shows the result panel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#cccccc;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="always" value="&lt;b&gt;Always on top:&lt;/b&gt; GlobalUI shows the studio logo (bottom-left) over every scene." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#cccccc;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue: scenes · Yellow: overlays · Green / red: result&lt;br&gt;Solid arrow: forward · Dashed arrow: back / again&lt;br&gt;Grey dashed box: planned, not built yet" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#cccccc;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="420" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="boot" target="pre"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="pre" target="menu"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" value="Play" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="menu" target="levels"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4" value="Back" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="levels" target="menu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="105" /><mxPoint x="660" y="105" /></Array></mxGeometry></mxCell>
        <mxCell id="g5" value="pick a level" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="levels" target="gamebox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g6" value="Pause /&lt;br&gt;Settings" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="gamebox" target="overlays"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g7" value="Resume" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.8;" edge="1" parent="1" source="overlays" target="gamebox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g8" value="win / lose" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="gamebox" target="results"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g9" value="Replay / Retry / Next" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.95;" edge="1" parent="1" source="results" target="gamebox"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="685" /><mxPoint x="1160" y="518" /></Array></mxGeometry></mxCell>
        <mxCell id="g10" value="Home / Quit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="results" target="menu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="685" /><mxPoint x="510" y="250" /><mxPoint x="620" y="250" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

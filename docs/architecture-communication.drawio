<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0">
  <diagram id="communication" name="Communication (backend + bridge)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="830" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;How a CV game talks to the outside world&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666666&quot;&gt;One backend server for every frontend. Each game sets a data mode in game.config.ts: &lt;b&gt;api&lt;/b&gt; (usual) or &lt;b&gt;local&lt;/b&gt;. The game code is the same on every platform. (Proposed design)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="60" as="geometry" />
        </mxCell>

        <!-- Game -->
        <mxCell id="game" value="CV Game&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(Phaser, runs inside a browser view)&lt;/font&gt;" style="swimlane;html=1;startSize=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="340" height="550" as="geometry" />
        </mxCell>
        <mxCell id="gameplay" value="&lt;b&gt;Gameplay&lt;/b&gt; (src/game)&lt;br&gt;ctx.win() · ctx.lose() · ctx.setHud()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="game">
          <mxGeometry x="40" y="64" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="core" value="&lt;b&gt;Core&lt;/b&gt; (src/core)&lt;br&gt;level start / end · progress · settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="game">
          <mxGeometry x="40" y="150" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="apiClient" value="&lt;b&gt;API client&lt;/b&gt; (core)&lt;br&gt;fetch() · player token · offline queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="game">
          <mxGeometry x="40" y="250" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="localStore" value="&lt;b&gt;Local storage&lt;/b&gt; (core)&lt;br&gt;keys cv_game_&amp;lt;gameId&amp;gt;_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="game">
          <mxGeometry x="40" y="360" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="bridge" value="&lt;b&gt;JS bridge&lt;/b&gt; (core, adapter picked automatically)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flutter: window.CVBridge.postMessage()&lt;br&gt;Web: window.parent.postMessage() · alone: no-op&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="game">
          <mxGeometry x="40" y="450" width="280" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="game" source="gameplay" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="api (usual)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4d7a3a;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="game" source="core" target="apiClient">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="local" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#9c7a12;labelBackgroundColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="game" source="core" target="localStore">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="178" /><mxPoint x="20" y="388" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" parent="game" source="localStore" target="bridge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- api mode lane -->
        <mxCell id="laneApi" value="&lt;b&gt;api mode (usual)&lt;/b&gt; · the game sends its own results straight to the backend, on every platform" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#f7fbf5;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="1040" height="340" as="geometry" />
        </mxCell>
        <mxCell id="frontends" value="Frontends &lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;(the game runs inside one)&lt;/font&gt;" style="swimlane;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fWeb" value="&lt;b&gt;Website&lt;/b&gt; · game in an iframe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="frontends">
          <mxGeometry x="20" y="44" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fFlutter" value="&lt;b&gt;Flutter app&lt;/b&gt; · game in a WebView" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="frontends">
          <mxGeometry x="20" y="94" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fPlay" value="&lt;b&gt;Play Store build&lt;/b&gt; · the game is the app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;" vertex="1" parent="frontends">
          <mxGeometry x="20" y="144" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="&lt;b style=&quot;font-size:15px&quot;&gt;Backend server&lt;/b&gt;&lt;br&gt;ONE for every frontend and game&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;(likely Node.js)&lt;/font&gt;&lt;br&gt;&lt;br&gt;REST API&lt;br&gt;login · player tokens&lt;br&gt;progress · results · accounts&lt;br&gt;CORS for app origins" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="150" width="250" height="290" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="login · accounts" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#f7fbf5;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="frontends" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="player token (when the game opens)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=10;fontColor=#9673a6;strokeColor=#9673a6;labelBackgroundColor=#f7fbf5;exitX=0.5;exitY=1;entryX=1;entryY=0.2;" edge="1" parent="1" source="frontends" target="apiClient">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="results · progress · HTTPS, direct" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#f7fbf5;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.7;entryX=0;entryY=0.893;" edge="1" parent="1" source="apiClient" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- local mode lane -->
        <mxCell id="laneLocal" value="&lt;b&gt;local mode&lt;/b&gt; · no backend. Data stays on the device; the host reads it through the JS bridge" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#fffcf2;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="1040" height="200" as="geometry" />
        </mxCell>
        <mxCell id="device" value="&lt;b&gt;Device storage&lt;/b&gt;&lt;br&gt;browser localStorage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1180" y="495" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hosts" value="Hosts that read the data" style="swimlane;html=1;startSize=26;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="555" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="hFlutter" value="&lt;b&gt;Flutter app&lt;/b&gt; · JavaScriptChannel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="hosts">
          <mxGeometry x="20" y="34" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hOther" value="&lt;b&gt;Other page / service&lt;/b&gt; · postMessage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="hosts">
          <mxGeometry x="20" y="69" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="save on device" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#fffcf2;strokeColor=#d6b656;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="localStore" target="device">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="498" /><mxPoint x="400" y="525" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="l2" value="levelEnd · progress" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#fffcf2;strokeColor=#d6b656;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.45;" edge="1" parent="1" source="bridge" target="hosts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="getData · setProgress · pause · mute" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=10;fontColor=#9673a6;strokeColor=#9673a6;labelBackgroundColor=#fffcf2;exitX=0;exitY=0.85;entryX=1;entryY=0.75;" edge="1" parent="1" source="hosts" target="bridge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4d7a3a&quot;&gt;Green: api mode&lt;/font&gt; · &lt;font color=&quot;#9c7a12&quot;&gt;Yellow: local mode&lt;/font&gt; · &lt;font color=&quot;#9673a6&quot;&gt;Purple: frontends / hosts&lt;/font&gt;&lt;br&gt;Solid arrow: data going out · &lt;font color=&quot;#9673a6&quot;&gt;Dashed: into the game&lt;/font&gt;&lt;br&gt;Each host adds its bridge listener once; after that every local-mode game works there." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#cccccc;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- Message format -->
        <mxCell id="format" value="&lt;b&gt;Bridge message (local mode, same for every host)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;{ &quot;source&quot;: &quot;cv-game&quot;, &quot;version&quot;: 1, &quot;type&quot;: &quot;levelEnd&quot;, &quot;gameId&quot;: 138, &quot;payload&quot;: { &quot;level&quot;: 2, &quot;score&quot;: 300, &quot;stars&quot;: 3, &quot;won&quot;: true } }&lt;/font&gt;&lt;br&gt;&lt;b&gt;Game → host:&lt;/b&gt; ready · levelStart · levelEnd · progress · exit &amp;nbsp;&amp;nbsp; &lt;b&gt;Host → game:&lt;/b&gt; getData · setProgress · pause · resume · mute · setLanguage" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="700" width="1040" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
